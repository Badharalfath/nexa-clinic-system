flowchart LR
    %% ============================================================
    %% ERD — Mini Clinic Information System
    %% Gaya referensi: semua node rounded rectangle, alur satu arah,
    %% hitam-putih, kolom ringkas, 8 relasi berlabel
    %% ============================================================

    classDef tbl fill:#ffffff,stroke:#111111,stroke-width:1.5px,color:#111111,font-weight:700;
    classDef lbl fill:#ffffff,stroke:none,color:#111111,font-weight:400;

    USER(USER<br/>id<br/>username<br/>role):::tbl
    PATIENT(PATIENT<br/>id<br/>nik<br/>name):::tbl
    POLYCLINIC(POLYCLINIC<br/>id<br/>name<br/>description):::tbl
    REGISTRATION(REGISTRATION<br/>id<br/>registration_date<br/>complaint):::tbl
    QUEUE(QUEUE<br/>id<br/>queue_number<br/>status):::tbl
    MEDICAL_RECORD(MEDICAL_RECORD<br/>id<br/>diagnosis<br/>soap_note):::tbl
    MEDICAL_ACTION(MEDICAL_ACTION<br/>id<br/>description<br/>cost):::tbl
    PRESCRIPTION(PRESCRIPTION<br/>id<br/>drug_name<br/>dosage<br/>cost):::tbl

    USER -->|handles| REGISTRATION
    PATIENT -->|registers| REGISTRATION
    POLYCLINIC -->|serves| REGISTRATION
    REGISTRATION -->|generates| QUEUE
    REGISTRATION -->|examination| MEDICAL_RECORD
    PATIENT -->|owns| MEDICAL_RECORD
    MEDICAL_RECORD -->|includes| MEDICAL_ACTION
    MEDICAL_RECORD -->|prescribes| PRESCRIPTION
